# ── LLM (Ollama) ─────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
NOVA_MODEL_NAME=gemma3:4b
NOVA_TEMPERATURE=0.7
NOVA_KEEP_ALIVE=-1
# NOVA_NUM_CTX=         # Uncomment to override model default context window
NOVA_LLM_TIMEOUT=120

# ── Web search ───────────────────────────────────────
TAVILY_API_KEY=

# ── Memory & RAG ─────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
MEMORY_DB_PATH=./data/nova_memory.db

# ── Observability (LangSmith) ────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=nova-agent

# ── API ──────────────────────────────────────────────
NOVA_API_HOST=0.0.0.0
NOVA_API_PORT=8000

# ── Code execution ───────────────────────────────────
CODE_EXEC_TIMEOUT=30
CODE_EXEC_MODE=subprocess

# ── Environment ──────────────────────────────────────
# Values: development, production
NOVA_ENV=development

# ── MCP ──────────────────────────────────────────────
MCP_TRANSPORT=http
