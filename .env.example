# ── LLM (Ollama) ─────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
NOVA_MODEL_NAME=gemma3:4b
NOVA_TEMPERATURE=0.7

# ── Web search ───────────────────────────────────────
TAVILY_API_KEY=

# ── Memory ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379
CHROMA_PERSIST_DIR=./data/chroma

# ── Observability (LangSmith) ────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=nova-agent

# ── API ──────────────────────────────────────────────
NOVA_API_HOST=0.0.0.0
NOVA_API_PORT=8000

# ── Code execution ───────────────────────────────────
CODE_EXEC_TIMEOUT=30
CODE_EXEC_MODE=subprocess

# ── MCP ──────────────────────────────────────────────
MCP_TRANSPORT=http
