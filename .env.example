# ── LLM provider ─────────────────────────────────────
# Values: ollama (local, default) | openai | anthropic
NOVA_PROVIDER=ollama
# Only needed when NOVA_PROVIDER is openai / anthropic:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Cloud endpoints are pinned so a local-LLM override in the environment cannot
# hijack them. Override only to target a proxy or compatible gateway.
NOVA_ANTHROPIC_BASE_URL=https://api.anthropic.com
NOVA_OPENAI_BASE_URL=https://api.openai.com/v1

# ── LLM (Ollama) ─────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# qwen3 has native tool calling — strongly recommended for the agent to use
# the connected-service tools reliably (gemma models tend to invent tool names).
NOVA_MODEL_NAME=qwen3:8b
NOVA_TEMPERATURE=0.7
NOVA_KEEP_ALIVE=-1
# Context window sent to Ollama. Defaults to 16384: NOVA's system prompt
# plus ~40 tool schemas overflow smaller windows, making Ollama truncate from
# the top so the model loses its instructions. Lower it only if VRAM is tight.
NOVA_NUM_CTX=16384
NOVA_LLM_TIMEOUT=120
# Thinking mode for reasoning models (qwen3, deepseek-r1...). Unset = model
# default. "false" answers ~5x faster but small models then get dates and
# tool arguments wrong — recommended only for chat without connected services.
# NOVA_REASONING=

# ── Web search ───────────────────────────────────────
TAVILY_API_KEY=

# ── Memory & RAG ─────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
MEMORY_DB_PATH=./data/nova_memory.db
# Auto-inject knowledge-base excerpts into each user turn (retrieve-then-read).
RAG_CONTEXT_CHUNKS=4
# Max Chroma cosine distance for an excerpt to be considered relevant (0-2).
# Lower = stricter (fewer, more on-topic excerpts); higher = more recall.
RAG_CONTEXT_MAX_DISTANCE=0.6

# ── Scheduler ────────────────────────────────────────
SCHEDULER_DB_PATH=./data/nova_scheduler.db

# ── Observability (LangSmith) ────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=nova-agent

# ── API ──────────────────────────────────────────────
NOVA_API_HOST=0.0.0.0
NOVA_API_PORT=8000

# ── Code execution ───────────────────────────────────
CODE_EXEC_TIMEOUT=30
CODE_EXEC_MODE=subprocess

# ── Environment ──────────────────────────────────────
# Values: development, production
NOVA_ENV=development

# ── MCP ──────────────────────────────────────────────
MCP_TRANSPORT=http

# ── External service connections (OAuth) ─────────────
# Public base URL used to build every provider's redirect URI, as
# {NOVA_PUBLIC_URL}/api/v1/connections/{provider}/callback — register that
# value verbatim in each provider's developer console.
# With the Vite dev server use http://localhost:5173 (it proxies /api to the
# API), so the OAuth popup shares an origin with the UI.
NOVA_PUBLIC_URL=http://localhost:5173
# Fernet key used to encrypt stored OAuth tokens. Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Left empty, a key is generated once into data/.connection_key (dev only).
NOVA_ENCRYPTION_KEY=
CONNECTIONS_DB_PATH=./data/nova_connections.db

# The OAuth client id/secret of each provider are normally registered from the
# setup wizard (sidebar → connections) and stored encrypted in the database.
# The variables below are an optional fallback for scripted deployments;
# database values take precedence when both exist. See docs/CONNECTIONS.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" allows any personal/work account; use a tenant id to restrict it.
MICROSOFT_TENANT_ID=common

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── GitHub (Roadmap widget) ──────────────────────────
# Personal Access Token with read:project scope
GITHUB_TOKEN=
GITHUB_PROJECT_OWNER=thisisrober
GITHUB_PROJECT_NUMBER=3

# ── GitHub (frontend — works without backend running)
VITE_GITHUB_TOKEN=
VITE_GITHUB_PROJECT_OWNER=thisisrober
VITE_GITHUB_PROJECT_NUMBER=3
